# Public application origin
NEXT_PUBLIC_APP_URL=https://verify.signallinkprotocol.com

# Supabase persistence
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-side-secret

# SignalLink signing: prefer asymmetric keys for production.
# Use literal \n sequences when storing PEM values in one-line secret managers.
SIGNALINK_PRIVATE_KEY=
SIGNALINK_PUBLIC_KEY=
SIGNALINK_HMAC_KEY=
SIGNALINK_SIGNER=SignalLink Protocol LLC / SignalLink AI

# Optional federal-source configuration. Keep keys server-side only.
NVD_API_KEY=
SAM_API_KEY=

# Optional commerce configuration
STRIPE_RESTRICTED_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_EVIDENCE_ANALYSIS=

# Optional production evidence workflow
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
VERCEL_TOKEN=

# Athena Preview gateway (signature adapter and durable worker must be implemented before live use)
ATHENA_ENV=preview
ATHENA_CLIENT_ID=
ATHENA_CLIENT_SECRET=
ATHENA_TOKEN_URL=https://api.preview.platform.athenahealth.com/oauth2/v1/token
ATHENA_PREVIEW_FHIR_BASE_URL=https://api.preview.platform.athenahealth.com/fhir/r4
ATHENA_PRODUCTION_FHIR_BASE_URL=https://api.platform.athenahealth.com/fhir/r4
ATHENA_WEBHOOK_SIGNING_SECRET=
ATHENA_SIGNATURE_PUBLIC_KEY=
ATHENA_SIGNATURE_ALGORITHM=
ATHENA_ADMIN_TOKEN=
ATHENA_QUEUE_ENDPOINT=
ATHENA_QUEUE_TOKEN=
ATHENA_ALLOW_RESOURCE_FETCH=false
