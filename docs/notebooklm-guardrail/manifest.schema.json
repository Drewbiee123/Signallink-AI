{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiprov.org/schemas/notebooklm-guardrail-manifest-v1.json",
  "title": "NotebookLM guardrail manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workflow_id", "captured_at", "sources", "answer_sha256"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "workflow_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "captured_at": { "type": "string", "format": "date-time" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "content_sha256"],
        "properties": {
          "source_id": { "type": "string", "minLength": 1, "maxLength": 500 },
          "content_sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "answer_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
